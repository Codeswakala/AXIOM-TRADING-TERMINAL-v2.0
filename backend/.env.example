# AXIOM Backend — W0-U08 hardened defaults
# Copy to .env and set secrets explicitly. Never commit real secrets.

AXIOM_APP_NAME=AXIOM
AXIOM_ENVIRONMENT=development
AXIOM_DEBUG=true
AXIOM_API_PREFIX=/api/v1
AXIOM_HOST=0.0.0.0
AXIOM_PORT=8000
AXIOM_LOG_LEVEL=INFO
AXIOM_LOG_JSON=false
AXIOM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# Database — production: postgresql+asyncpg://... and AUTO_CREATE_SCHEMA=false
AXIOM_DATABASE_URL=sqlite+aiosqlite:///./axiom_dev.db
AXIOM_DATABASE_ECHO=false
AXIOM_DATABASE_AUTO_CREATE_SCHEMA=false

# REQUIRED for non-test runs: secret length >= 32, no "CHANGE-ME" markers
AXIOM_JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
AXIOM_JWT_ALGORITHM=HS256
AXIOM_ACCESS_TOKEN_EXPIRE_MINUTES=30
AXIOM_REFRESH_TOKEN_EXPIRE_DAYS=7

# Local-only escape hatch for weak secrets / default bootstrap (never in production)
AXIOM_ALLOW_INSECURE_DEV=false

# Bootstrap admin — disabled by default. Enable only with strong password.
AXIOM_BOOTSTRAP_ADMIN_ENABLED=false
AXIOM_BOOTSTRAP_ADMIN_USERNAME=
AXIOM_BOOTSTRAP_ADMIN_PASSWORD=

# WebSocket: short-lived tickets (JWT in query disabled by default)
AXIOM_WS_TICKET_EXPIRE_SECONDS=60
AXIOM_WS_ALLOW_QUERY_JWT=false

AXIOM_PROTECT_INGESTION_STATS=true

# Live market
AXIOM_LIVE_MARKET_ENABLED=true
AXIOM_LIVE_MARKET_AUTO_START=false
AXIOM_LIVE_MARKET_CLASS=forex
AXIOM_LIVE_MARKET_SYMBOL=EURUSD
AXIOM_LIVE_MARKET_SYMBOLS=EURUSD,BTCUSD
AXIOM_LIVE_MARKET_TIMEFRAME=M1
AXIOM_LIVE_MARKET_INTERVAL_SECONDS=2.0
